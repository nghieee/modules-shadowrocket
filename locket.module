#!url=https://raw.githubusercontent.com/dhungx/modules-shadowrocket/refs/heads/main/locket.module
#!name=Locket Gold 🏅
#!desc=Mở khoá Locket Gold - Unlock tất cả tính năng premium
#!author=ng_hiee
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Award.png
# ～ Tương thích: Shadowrocket / Surge / LanceX
# ～ Cập nhật: 29/10/2024
# 
# ⚠️  LƯU Ý: Module này chỉ dùng cho mục đích học tập & nghiên cứu.
# ⚠️  Vui lòng hỗ trợ nhà phát triển nếu bạn thích ứng dụng.
#
# 📌 CÁCH DÙNG:
#   1. Bật MITM cho domain: api.revenuecat.com
#   2. Cài module này vào Shadowrocket
#   3. Mở lại Locket App

[General]
# Bắt buộc dùng HTTP engine cho RevenueCat
force-http-engine-hosts = api.revenuecat.com

[MITM]
# Cần bật MITM cho domain này
hostname = api.revenuecat.com

[Script]
# ~ By ng_hiee
# ～ Egern transfer to Shadowrocket & Surge & LanceX

# Bước 1: Xóa header cache trong REQUEST để server trả về response mới
locket-delete-header = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/dhungx/modules-shadowrocket/main/js/locket/deleteHeader.js, requires-body=false, timeout=10, tag=Locket-DeleteHeader

# Bước 2: Chỉnh sửa RESPONSE từ RevenueCat để inject Gold subscription
locket-response = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/dhungx/modules-shadowrocket/main/js/locket/Locket.js, requires-body=true, timeout=10, tag=Locket-Gold
